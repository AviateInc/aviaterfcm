{
    "name": "aviate-rf",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint . --max-warnings=0 && npm run format:check",
        "lint:fix": "eslint . --fix --max-warnings=0 && npm run format",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,css,json,yml,yaml}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,css,json,yml,yaml}\"",
        "typecheck": "next typegen && tsc --noEmit",
        "build:pages": "node scripts/build-pages.mjs"
    },
    "dependencies": {
        "lucide-react": "^1.79.0",
        "motion": "^14.14.0",
        "next": "16.4.6",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "@tailwindcss/turbopack": "4.3.3",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "daisyui": "^5.8.2",
        "eslint": "^9",
        "eslint-config-next": "16.4.6",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.10.1",
        "sharp": "^0.35.5",
        "tailwindcss": "4.3.3",
        "typescript": "^5"
    }
}
